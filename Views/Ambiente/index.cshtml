
@using GestaoReservas.Models
@model IEnumerable<Ambiente>

@{
    ViewData["Title"] = "Ambientes";
    Layout = null;
    var lista = Model?.ToList() ?? new List<Ambiente>();
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Santa Massa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/DetalhesEdicao.css" asp-append-version="true">

    <style>
        .ambientes-topo {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 18px;
        }

        .ambientes-contador {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 35px;
            padding: 7px 14px;
            border: 1px solid #756442;
            border-radius: 20px;
            background: #302C23;
            color: #E8D5A5;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }

        .ambientes-tabela-wrap {
            width: 100%;
            overflow-x: auto;
            border: 1px solid #49443A;
            border-radius: 10px;
        }

        .ambientes-tabela {
            width: 100%;
            min-width: 650px;
            border-collapse: collapse;
            font-family: 'Poppins', sans-serif;
            font-size: 12px;
        }

        .ambientes-tabela thead {
            background: #302E28;
        }

        .ambientes-tabela th {
            padding: 16px 15px;
            color: #C8C0B1;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1px;
            text-align: left;
            text-transform: uppercase;
            white-space: nowrap;
            border-bottom: 1px solid #49443A;
        }

        .ambientes-tabela td {
            padding: 17px 15px;
            color: #F7F3EA;
            border-bottom: 1px solid #3A3831;
            vertical-align: middle;
        }

        .ambientes-tabela tbody tr {
            background: #24231F;
            transition: background .2s ease;
        }

        .ambientes-tabela tbody tr:hover {
            background: #2D2B26;
        }

        .ambientes-tabela tbody tr:last-child td {
            border-bottom: none;
        }

        .ambiente-id {
            color: #A9A294 !important;
            font-size: 11px;
        }

        .ambiente-nome {
            color: #E8D5A5 !important;
            font-weight: 600;
        }

        .ambiente-capacidade {
            color: #E4DED2 !important;
            white-space: nowrap;
        }

        .ambiente-status {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 6px 10px;
            border: 1px solid #756442;
            border-radius: 20px;
            background: #302C23;
            color: #E8D5A5;
            font-size: 10px;
            font-weight: 600;
            white-space: nowrap;
        }

        .ambiente-acoes {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 7px;
        }

        .ambiente-acoes a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 31px;
            padding: 6px 10px;
            border: 1px solid #49443A;
            border-radius: 6px;
            background: #302E28;
            color: #E8D5A5;
            font-size: 10px;
            font-weight: 500;
            text-decoration: none;
            white-space: nowrap;
            transition: all .2s ease;
        }

        .ambiente-acoes a:hover {
            border-color: #D3B779;
            background: #3A352A;
            color: #FFFFFF;
        }

        .ambiente-acoes a.ambiente-excluir {
            border-color: #633C37;
            background: #332421;
            color: #E7A09A;
        }

        .ambiente-acoes a.ambiente-excluir:hover {
            border-color: #B85D53;
            background: #432925;
            color: #FFD3CE;
        }

        .ambientes-acoes-topo {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 22px;
        }

        .ambientes-botao-novo {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 11px 19px;
            border: 1px solid #D3B779;
            border-radius: 8px;
            background: #D3B779;
            color: #1F1F1D;
            font-family: 'Poppins', sans-serif;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: all .2s ease;
        }

        .ambientes-botao-novo:hover {
            transform: translateY(-1px);
            border-color: #E8D5A5;
            background: #E8D5A5;
            color: #1F1F1D;
            box-shadow: 0 5px 14px rgb(0 0 0 / 20%);
        }

        .ambientes-vazio {
            padding: 55px 24px;
            text-align: center;
        }

        .ambientes-vazio h2 {
            margin: 0 0 12px;
            color: #F7F3EA;
            font-family: 'Josefin Sans', sans-serif;
            font-size: 25px;
            font-weight: 600;
        }

        .ambientes-vazio p {
            max-width: 440px;
            margin: 0 auto 25px;
            color: #C8C0B1;
            font-size: 12px;
            line-height: 1.8;
        }

        .ambientes-vazio-icone {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 58px;
            height: 58px;
            margin: 0 auto 20px;
            border: 1px solid #625640;
            border-radius: 16px;
            background: #302C23;
            color: #D3B779;
            font-family: 'Josefin Sans', sans-serif;
            font-size: 25px;
        }

        .ambientes-rodape {
            padding: 17px 25px;
            border-top: 1px solid #49443A;
            color: #A9A294;
            font-size: 10px;
            text-align: center;
            letter-spacing: .3px;
        }

        @@media (max-width: 650px) {
            .ambientes-topo {
                align-items: flex-start;
            }

            .ambientes-contador {
                margin-top: 3px;
            }

            .ambientes-acoes-topo {
                justify-content: stretch;
            }

            .ambientes-botao-novo {
                width: 100%;
            }

            .ambientes-vazio {
                padding: 40px 20px;
            }
        }
    </style>
</head>

<body class="detalhes-edicao-page">
    <main class="detalhes-edicao-container">

        <a asp-controller="AreaRestaurante"
           asp-action="Index"
           class="detalhes-edicao-voltar">
            ← Voltar à área do restaurante
        </a>

        <section class="detalhes-edicao-card">

            <header class="detalhes-edicao-header">
                <div class="ambientes-topo">
                    <div>
                        <p class="detalhes-edicao-kicker">
                            Santa Massa · Rio Preto
                        </p>

                        <h1>Ambientes</h1>

                        <p class="detalhes-edicao-descricao">
                            Gerencie os espaços e a capacidade do restaurante.
                        </p>
                    </div>

                    <span class="ambientes-contador">
                        @lista.Count @(lista.Count == 1 ? "ambiente cadastrado" : "ambientes cadastrados")
                    </span>
                </div>
            </header>

            <div class="detalhes-edicao-conteudo">

                @if (!lista.Any())
                {
                    <div class="ambientes-vazio">
                        <div class="ambientes-vazio-icone">+</div>

                        <h2>Nenhum ambiente cadastrado</h2>

                        <p>
                            Cadastre o primeiro ambiente para organizar os espaços
                            e facilitar a distribuição das mesas do restaurante.
                        </p>

                        <a asp-action="Create" class="ambientes-botao-novo">
                            + Cadastrar ambiente
                        </a>
                    </div>
                }
                else
                {
                    <div class="ambientes-acoes-topo">
                        <a asp-action="Create" class="ambientes-botao-novo">
                            + Cadastrar ambiente
                        </a>
                    </div>

                    <div class="ambientes-tabela-wrap">
                        <table class="ambientes-tabela">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nome do ambiente</th>
                                    <th>Capacidade</th>
                                    <th>Status</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var ambiente in lista)
                                {
                                    <tr>
                                        <td class="ambiente-id">
                                            #@ambiente.Id
                                        </td>

                                        <td class="ambiente-nome">
                                            @ambiente.Nome
                                        </td>

                                        <td class="ambiente-capacidade">
                                            @ambiente.Capacidade
                                            @(ambiente.Capacidade == 1 ? "pessoa" : "pessoas")
                                        </td>

                                        <td>
                                            <span class="ambiente-status">
                                                @(string.IsNullOrWhiteSpace(ambiente.Status)
                                                    ? "Não informado"
                                                    : ambiente.Status)
                                            </span>
                                        </td>

                                        <td>
                                            <div class="ambiente-acoes">
                                                <a asp-action="Details"
                                                   asp-route-id="@ambiente.Id">
                                                    Detalhes
                                                </a>

                                                <a asp-action="Edit"
                                                   asp-route-id="@ambiente.Id">
                                                    Editar
                                                </a>

                                                <a asp-action="Delete"
                                                   asp-route-id="@ambiente.Id"
                                                   class="ambiente-excluir">
                                                    Excluir
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>

            <footer class="ambientes-rodape">
                Santa Massa · Painel de gerenciamento
            </footer>

        </section>
    </main>
</body>
</html>
