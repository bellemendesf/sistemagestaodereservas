@model List<Ambiente>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body class="container">
    <table class="table">
        @foreach(Ambiente a in Model)
        {
        <tr>
            <td>@a.Id</td>
            <td>@a.Status</td>
            <td>@a.Nome</td>
            <td>@a.Capacidade</td>
            <td>
                <a class="btn btn-info btn-sm" href="/tarefa/update/@a.Id">Editar</a>
                <a class="btn btn-danger btn-sm" href="/tarefa/delete/@a.Id">Apagar</a>
                <a class="btn btn-info btn-sm" href="/tarefa/update/@a.Nome">Editar</a>
                <a class="btn btn-danger btn-sm" href="/tarefa/delete/@a.Nome">Apagar</a>
                <a class="btn btn-info btn-sm" href="/tarefa/update/@a.Status">Editar</a>
                <a class="btn btn-danger btn-sm" href="/tarefa/delete/@a.Status">Apagar</a>
                <a class="btn btn-info btn-sm" href="/tarefa/update/@a.Capacidade">Editar</a>
                <a class="btn btn-danger btn-sm" href="/tarefa/delete/@a.Capacidade">Apagar</a>
            </td>
        </tr>
        }
    </table>

    <a class="btn btn-primary" href="/tarefa/create">Adicionar</a>
</body>
</html>