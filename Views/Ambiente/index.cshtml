@using GestaoReservas.Models
@model List<GestaoReservas.Models.Ambiente>

@{
    ViewData["Title"] = "Ambientes";
}

<h1>Ambientes</h1>

<p>
    <a asp-action="Create">Nova área</a>
</p>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Status</th>
            <th>Capacidade</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var ambiente in Model)
        {
            <tr>
                <td>@ambiente.Id</td>
                <td>@ambiente.Nome</td>
                <td>@ambiente.Status</td>
                <td>@ambiente.Capacidade</td>

                <td>
                    <a asp-action="Details" asp-route-id="@ambiente.Id">
                        Detalhes
                    </a>

                    <a asp-action="Edit" asp-route-id="@ambiente.Id">
                        Editar
                    </a>

                    <a asp-action="Delete" asp-route-id="@ambiente.Id">
                        Excluir
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>