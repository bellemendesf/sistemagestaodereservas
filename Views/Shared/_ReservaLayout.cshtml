
@* Bloco C#: configurações da view (título, layout e variáveis) *@
@{
    // Variável restaurante
    bool restaurante = string.Equals(
        ViewContext.RouteData.Values["controller"]?.ToString(),
        "AreaRestaurante",
        StringComparison.OrdinalIgnoreCase);

    // Variável action
    var action = ViewContext.RouteData.Values["action"]?.ToString();

}
@* Tipo do documento (HTML5) *@
<!DOCTYPE html>
@* Início do documento HTML *@
<html lang="pt-br">
@* Cabeçalho do documento (título, fontes e estilos) *@
<head>
    @* Configuração da página *@
    <meta charset="utf-8" />
    @* Configuração da página *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* Título da aba *@
    <title>@ViewData["Title"] - Santa Massa</title>

    @* Arquivo de estilo/fonte externo *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    @* Arquivo de estilo/fonte externo *@
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    @* Arquivo de estilo/fonte externo *@
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap"
          rel="stylesheet" />

    @* Arquivo de estilo/fonte externo *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
          crossorigin="anonymous" />

    @* Arquivo de estilo/fonte externo *@
    <link rel="stylesheet" href="~/css/Reserva.css" asp-append-version="true" />
    @* Arquivo de estilo/fonte externo *@
    <link rel="stylesheet" href="~/css/ReservasIndex.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Listagens.css" asp-append-version="true" />
</head>

@* Corpo da página *@
<body class="page-reserva has-fixed-page-top">
@await Component.InvokeAsync("ReservaPageTop")

    @* Conteúdo principal *@
    <main class="page-shell">
        @* Seção da página *@
        <section class="page-intro">
            @* Parágrafo de texto *@
            <p class="page-kicker">SANTA MASSA · GESTÃO DE RESERVAS</p>

            @* Título principal *@
            <h1>@ViewData["Title"]</h1>

            @* Parágrafo de texto *@
            <p class="page-lead">
                @(restaurante
                    ? "Acompanhe e organize as reservas do restaurante."
                    : "Suas reservas em um só lugar: visualize, altere ou cancele.")
            </p>
        </section>

        @* Bloco (classe page-content) *@
        <div class="page-content">
            @* Aqui entra o conteúdo de cada view *@
            @RenderBody()
        </div>
    </main>
</body>
</html>
