@* Tipo de dado (modelo) que esta view recebe do controller *@
@model GestaoReservas.Models.Mesa

@* Bloco C#: configurações da view (título, layout e variáveis) *@
@{
    ViewData["Title"] = "Cadastrar Mesa";
    // Atribui Layout
    Layout = null;
}

@* Tipo do documento (HTML5) *@
<!DOCTYPE html>
@* Início do documento HTML *@
<html lang="pt-BR">
@* Cabeçalho do documento (título, fontes e estilos) *@
<head>
    @* Configuração da página *@
    <meta charset="UTF-8">
    @* Configuração da página *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @* Título da aba *@
    <title>@ViewData["Title"] - Santa Massa</title>

    @* Arquivo de estilo/fonte externo *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    @* Arquivo de estilo/fonte externo *@
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* Arquivo de estilo/fonte externo *@
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    @* Arquivo de estilo/fonte externo *@
    <link rel="stylesheet" href="~/css/Mesas.css" asp-append-version="true">
</head>

@* Corpo da página *@
<body class="mesas-page">
@* Conteúdo principal *@
<main class="mesas-container">
    @* Link (asp-action Index) *@
    <a asp-action="Index" class="mesas-voltar">
        ← Voltar às mesas
    </a>

    @* Seção da página *@
    <section class="mesas-card">
        @* Cabeçalho *@
        <header class="mesas-header">
            @* Bloco *@
            <div>
                @* Parágrafo de texto *@
                <p class="mesas-kicker">Santa Massa · Rio Preto</p>
                @* Título principal *@
                <h1>Cadastrar mesa</h1>
                @* Parágrafo de texto *@
                <p class="mesas-descricao">
                    Cadastre uma mesa e defina sua capacidade e disponibilidade.
                </p>
            </div>
        </header>

        @* Bloco (classe mesas-conteudo) *@
        <div class="mesas-conteudo">
            
@* Formulário (asp-action Create) *@
<form asp-action="Create" method="post" class="mesas-form">
    @* Resumo dos erros de validação *@
    <div asp-validation-summary="All" class="mesas-erro"></div>

    @* Bloco (classe mesas-campo) *@
    <div class="mesas-campo">
        @* Rótulo do campo (asp-for Numero) *@
        <label asp-for="Numero">Número da mesa</label>
        @* Campo de entrada (asp-for Numero) *@
        <input asp-for="Numero" type="number" min="1" placeholder="Ex.: 4" />
        @* Texto destacado *@
        <span asp-validation-for="Numero" class="mesas-erro"></span>
    </div>

    @* Bloco (classe mesas-campo) *@
    <div class="mesas-campo">
        @* Rótulo do campo (asp-for QtdLugares) *@
        <label asp-for="QtdLugares">Quantidade de lugares</label>
        @* Campo de entrada (asp-for QtdLugares) *@
        <input asp-for="QtdLugares" type="number" min="1" placeholder="Ex.: 4" />
        @* Texto destacado *@
        <span asp-validation-for="QtdLugares" class="mesas-erro"></span>
    </div>

        
@* Bloco (classe mesas-campo) *@
<div class="mesas-campo">
    @* Rótulo do campo (asp-for AmbienteId) *@
    <label asp-for="AmbienteId">Ambiente</label>

    @* Lista de seleção (asp-for AmbienteId) *@
    <select asp-for="AmbienteId"
            asp-items="ViewBag.Ambientes">
        @* Opção da lista *@
        <option value="0">Selecione o ambiente</option>
    </select>

    @* Texto destacado *@
    <span asp-validation-for="AmbienteId"
          class="mesas-erro"></span>
</div>



    @* Bloco (classe mesas-campo) *@
    <div class="mesas-campo">
        @* Rótulo do campo (asp-for Status) *@
        <label asp-for="Status">Status da mesa</label>
        @* Lista de seleção (asp-for Status) *@
        <select asp-for="Status">
            @* Opção da lista *@
            <option value="">Selecione o status</option>
            @* Opção da lista *@
            <option value="Livre">Livre</option>
            @* Opção da lista *@
            <option value="Reservada">Reservada</option>
            @* Opção da lista *@
            <option value="Ocupada">Ocupada</option>
        </select>
        @* Texto destacado *@
        <span asp-validation-for="Status" class="mesas-erro"></span>
    </div>

    @* Bloco (classe mesas-acoes) *@
    <div class="mesas-acoes">
        @* Botão *@
        <button type="submit" class="mesas-botao-principal">Cadastrar mesa</button>
        @* Link (asp-action Index) *@
        <a asp-action="Index" class="mesas-botao-secundario">Cancelar</a>
    </div>
</form>

        </div>

        @* Rodapé *@
        <footer class="mesas-footer">
            Santa Massa · Painel de gerenciamento
        </footer>
    </section>
</main>

</body>
</html>