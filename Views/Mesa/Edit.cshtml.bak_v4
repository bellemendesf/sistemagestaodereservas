@* Tipo de dado (modelo) que esta view recebe do controller *@
@model GestaoReservas.Models.Mesa

@* Bloco C#: configurações da view (título, layout e variáveis) *@
@{
    ViewData["Title"] = "Editar Mesa";
    // Atribui Layout
    Layout = null;
}

@* Tipo do documento (HTML5) *@
<!DOCTYPE html>
@* Início do documento HTML *@
<html lang="pt-BR">
@* Cabeçalho do documento (título, fontes e estilos) *@
<head>
    @* Configuração da página *@
    <meta charset="UTF-8">
    @* Configuração da página *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @* Título da aba *@
    <title>@ViewData["Title"] - Santa Massa</title>

    @* Arquivo de estilo/fonte externo *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    @* Arquivo de estilo/fonte externo *@
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* Arquivo de estilo/fonte externo *@
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    @* Arquivo de estilo/fonte externo *@
    <link rel="stylesheet" href="~/css/DetalhesEdicao.css" asp-append-version="true">
</head>
@* Corpo da página *@
<body class="detalhes-edicao-page">
    @* Conteúdo principal *@
    <main class="detalhes-edicao-container">
        @* Link (asp-action Index) *@
        <a asp-action="Index" class="detalhes-edicao-voltar">← Voltar às mesas</a>

        @* Seção da página *@
        <section class="detalhes-edicao-card">
            @* Cabeçalho *@
            <header class="detalhes-edicao-header">
                @* Parágrafo de texto *@
                <p class="detalhes-edicao-kicker">Santa Massa · Rio Preto</p>
                @* Título principal *@
                <h1>Editar mesa</h1>
                @* Parágrafo de texto *@
                <p class="detalhes-edicao-descricao">
                    Atualize o número, a capacidade ou o status da mesa.
                </p>
            </header>

            @* Bloco (classe detalhes-edicao-conteudo) *@
            <div class="detalhes-edicao-conteudo">
                @* Formulário (asp-action Edit, id @Model.Id) *@
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="detalhes-edicao-form">
                    @* Campo de entrada (asp-for Id) *@
                    <input type="hidden" asp-for="Id" />

                    @* Resumo dos erros de validação *@
                    <div asp-validation-summary="All" class="detalhes-edicao-erros"></div>

                    @* Bloco (classe detalhes-edicao-campo) *@
                    <div class="detalhes-edicao-campo">
                        @* Rótulo do campo (asp-for Numero) *@
                        <label asp-for="Numero">Número da mesa</label>
                        @* Campo de entrada (asp-for Numero) *@
                        <input asp-for="Numero" type="number" class="form-control" />
                        @* Texto destacado *@
                        <span asp-validation-for="Numero" class="detalhes-edicao-erros"></span>
                    </div>

                    @* Bloco (classe detalhes-edicao-campo) *@
                    <div class="detalhes-edicao-campo">
                        @* Rótulo do campo (asp-for QtdLugares) *@
                        <label asp-for="QtdLugares">Quantidade de lugares</label>
                        @* Campo de entrada (asp-for QtdLugares) *@
                        <input asp-for="QtdLugares" type="number" min="1" />
                        @* Texto destacado *@
                        <span asp-validation-for="QtdLugares" class="detalhes-edicao-erros"></span>
                    </div>

                                        
                    @* Bloco (classe detalhes-edicao-campo) *@
                    <div class="detalhes-edicao-campo">
                        @* Rótulo do campo (asp-for AmbienteId) *@
                        <label asp-for="AmbienteId">Ambiente</label>

                        @* Lista de seleção (asp-for AmbienteId) *@
                        <select asp-for="AmbienteId"
                                asp-items="ViewBag.Ambientes">
                            @* Opção da lista *@
                            <option value="0">Selecione o ambiente</option>
                        </select>

                        @* Texto destacado *@
                        <span asp-validation-for="AmbienteId"
                            class="detalhes-edicao-erros"></span>
                    </div>


                    @* Bloco (classe detalhes-edicao-campo) *@
                    <div class="detalhes-edicao-campo">
                        @* Rótulo do campo (asp-for Status) *@
                        <label asp-for="Status">Status da mesa</label>
                        @* Campo de entrada (asp-for Status) *@
                        <input asp-for="Status" placeholder="Ex.: Livre, Reservada ou Ocupada" />
                        @* Texto destacado *@
                        <span asp-validation-for="Status" class="detalhes-edicao-erros"></span>
                    </div>

                    @* Bloco (classe detalhes-edicao-acoes) *@
                    <div class="detalhes-edicao-acoes">
                        @* Botão *@
                        <button type="submit"
                                class="detalhes-edicao-botao detalhes-edicao-botao-principal">
                            Salvar alterações
                        </button>

                        @* Link (asp-action Index) *@
                        <a asp-action="Index"
                           class="detalhes-edicao-botao detalhes-edicao-botao-secundario">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>

            @* Rodapé *@
            <footer class="detalhes-edicao-rodape">
                Santa Massa · Painel de gerenciamento
            </footer>
        </section>
    </main>
</body>
</html>