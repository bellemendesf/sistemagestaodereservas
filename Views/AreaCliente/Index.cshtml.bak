
@{
    ViewData["Title"] = "Área do Cliente";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] - Santa Massa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;600;700&family=Poppins:wght@400;500;600&display=swap"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/Areas.css"
          asp-append-version="true">
</head>

<body class="area-page">
    <main class="area-container">

        <a asp-controller="Home"
           asp-action="Index"
           class="back-link">
            ← Voltar ao início
        </a>

        <header class="area-header">
            <img src="~/images/logosantamassa.jpg"
                 alt="Logo Santa Massa"
                 class="area-logo">

            <p class="area-kicker">
                SANTA MASSA · RIO PRETO
            </p>

            <h1>Área do Cliente</h1>

            <p>Como podemos ajudar você?</p>
        </header>

        <section class="area-grid"
                 aria-label="Opções do cliente">

            <a asp-controller="Cliente"
               asp-action="Create"
               class="area-card">

                <div>
                    <h2>Meu cadastro</h2>
                    <p>Cadastre seus dados para utilizar o sistema.</p>
                </div>

                <span class="card-link">Fazer cadastro</span>
            </a>

            <a asp-controller="Reserva"
               asp-action="Create"
               class="area-card">

                <div>
                    <h2>Fazer uma reserva</h2>
                    <p>Organize sua próxima visita ao restaurante.</p>
                </div>

                <span class="card-link">Nova reserva</span>
            </a>

            <a asp-controller="Reserva"
               asp-action="Index"
               class="area-card">

                <div>
                    <h2>Minhas reservas</h2>
                    <p>Consulte as reservas disponíveis no sistema.</p>
                </div>

                <span class="card-link">Consultar</span>
            </a>

            <a asp-controller="Reserva"
               asp-action="Index"
               class="area-card">

                <div>
                    <h2>Cancelar uma reserva</h2>
                    <p>Acesse suas reservas para verificar as opções de cancelamento.</p>
                </div>

                <span class="card-link">Ver reservas</span>
            </a>

        </section>

        <footer class="area-footer">
            Santa Massa · São José do Rio Preto
        </footer>

    </main>
</body>
</html>
