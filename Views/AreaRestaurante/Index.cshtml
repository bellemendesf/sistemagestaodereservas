
@{
    ViewData["Title"] = "Área do Restaurante";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Santa Massa</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link rel="stylesheet" href="~/css/Areas.css" asp-append-version="true">
</head>
<body class="area-page">
    <main class="area-container">
        <a asp-controller="Home" asp-action="Index" class="back-link">
            ← Voltar ao início
        </a>

        <header class="area-header">
            <img src="~/images/logosantamassa.jpg"
                 alt="Logo Santa Massa"
                 class="area-logo">

            <p class="area-kicker">SANTA MASSA · RIO PRETO</p>
            <h1>Área do Restaurante</h1>
            <p>Gerencie as operações do restaurante.</p>
        </header>

        <section class="area-grid">
             <a asp-controller="Funcionario"
               asp-action="Create"
               class="area-card">
                <span class="area-icon">♟</span>
                <h2>Funcionarios</h2>
                <span class="card-link">Cadastrar</span>
            </a>
            <a asp-controller="Reserva"
               asp-action="Index"
               class="area-card">
                <span class="area-icon">▤</span>
                <h2>Gerenciar reservas</h2>
                <span class="card-link">Acessar reservas</span>
            </a>

            <a asp-controller="Mesa"
               asp-action="Index"
               class="area-card">
                <span class="area-icon">▦</span>
                <h2>Gerenciar mesas</h2>
                <span class="card-link">Acessar mesas</span>
            </a>

            <a asp-controller="Ambiente"
               asp-action="Index"
               class="area-card">
                <span class="area-icon">⌂</span>
                <h2>Gerenciar ambientes</h2>
                <span class="card-link">Acessar ambientes</span>
            </a>
           
        </section>

        <footer class="area-footer">
            Santa Massa · Painel de gerenciamento
        </footer>
    </main>
</body>
</html>
