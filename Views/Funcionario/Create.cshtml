@model Funcionario

@{
    Layout = null;
    ViewData["Title"] = "Cadastrar funcionário";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] | Santa Massa</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;600;700&family=Poppins:wght@400;500;600&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/Cadastro.css" asp-append-version="true">
</head>

<body class="cadastro-page">

    <main class="cadastro-container">

        <nav class="cadastro-nav">
            <a asp-controller="Home" asp-action="Index">
                ← Página inicial
            </a>

            <div>
                <a asp-controller="Cliente" asp-action="Index">Clientes</a>
                <span class="text-secondary"> · </span>
                <a asp-controller="Funcionario" asp-action="Index">
                    Funcionários
                </a>
            </div>
        </nav>

        <section class="cadastro-card">

            <p class="cadastro-subtitulo">Santa Massa · Área administrativa</p>

            <h1>Novo funcionário</h1>

            <p class="cadastro-descricao">
                Preencha os dados para cadastrar um funcionário
                no sistema do restaurante.
            </p>

            @Html.ValidationSummary(
                false,
                "",
                new { @class = "cadastro-erros" }
            )

            <form action="/Funcionario/Create"
                  method="POST"
                  class="cadastro-form">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="Nome" class="form-label">Nome completo</label>
                    <input id="Nome"
                           name="Nome"
                           type="text"
                           value="@Model.Nome"
                           class="form-control"
                           placeholder="Digite o nome completo"
                           autocomplete="name"
                           required>
                </div>

                <div class="mb-3">
                    <label for="Cpf" class="form-label">CPF</label>
                    <input id="Cpf"
                           name="Cpf"
                           type="text"
                           value="@Model.Cpf"
                           class="form-control"
                           placeholder="Digite o CPF"
                           autocomplete="off"
                           required>
                </div>

                <div class="mb-3">
                    <label for="EmailPessoal" class="form-label">
                        E-mail pessoal
                    </label>
                    <input id="EmailPessoal"
                           name="EmailPessoal"
                           type="email"
                           value="@Model.EmailPessoal"
                           class="form-control"
                           placeholder="voce@exemplo.com"
                           autocomplete="email"
                           required>
                </div>

                <div class="mb-3">
                    <label for="EmailInstitucional" class="form-label">
                        E-mail institucional
                    </label>
                    <input id="EmailInstitucional"
                           name="EmailInstitucional"
                           type="email"
                           value="@Model.EmailInstitucional"
                           class="form-control"
                           placeholder="Digite o e-mail institucional"
                           autocomplete="off"
                           required>
                </div>

                <div class="mb-3">
                    <label for="Senha" class="form-label">Senha</label>
                    <input id="Senha"
                           name="Senha"
                           type="password"
                           class="form-control"
                           placeholder="Crie uma senha"
                           autocomplete="new-password"
                           required>
                </div>

                <div class="cadastro-botoes">
                    <button type="submit"
                            class="btn-cadastro btn-cadastro-salvar">
                        Cadastrar funcionário
                    </button>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn-cadastro btn-cadastro-voltar">
                        Voltar
                    </a>
                </div>

            </form>
        </section>

    </main>

</body>
</html>