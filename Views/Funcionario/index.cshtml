 @model List<Funcionario>

@{
    Layout = null;
    ViewData["Title"] = "Funcionários cadastrados";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] | Santa Massa</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;600;700&family=Poppins:wght@400;500;600&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/Funcionarios.css"
          asp-append-version="true">
</head>

<body class="funcionarios-page">

    <main class="funcionarios-container">

        <nav class="funcionarios-nav">
            <a asp-controller="AreaRestaurante" asp-action="Index">
                ← Voltar à Área do Restaurante
            </a>
        </nav>

        <section class="funcionarios-card">

            <header class="funcionarios-header">
                <div>
                    <p class="funcionarios-kicker">
                        Santa Massa · Rio Preto
                    </p>

                    <h1>Funcionários cadastrados</h1>

                    <p class="funcionarios-descricao">
                        Consulte e gerencie os dados da equipe do restaurante.
                    </p>
                </div>

                <a asp-controller="Funcionario"
                   asp-action="Create"
                   class="btn-funcionario-novo">
                    + Cadastrar funcionário
                </a>
            </header>

            <div class="funcionarios-conteudo">

                @if (Model == null || Model.Count == 0)
                {
                    <div class="funcionarios-vazio">
                        <h2>Nenhum funcionário cadastrado</h2>

                        <p>
                            Os funcionários cadastrados aparecerão nesta lista.
                        </p>

                        <a asp-controller="Funcionario"
                           asp-action="Create"
                           class="btn-funcionario-novo">
                            Cadastrar primeiro funcionário
                        </a>
                    </div>
                }
                else
                {
                    <p class="funcionarios-contagem">
                        Total de registros: <strong>@Model.Count</strong>
                    </p>

                    <div class="funcionarios-tabela">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nome</th>
                                    <th>CPF</th>
                                    <th>E-mail pessoal</th>
                                    <th>E-mail institucional</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (Funcionario item in Model)
                                {
                                    <tr>
                                        <td class="funcionario-id">
                                            @item.Id
                                        </td>

                                        <td class="funcionario-nome">
                                            @item.Nome
                                        </td>

                                        <td>@item.Cpf</td>

                                        <td>@item.EmailPessoal</td>

                                        <td>@item.EmailInstitucional</td>

                                        <td>
                                            <div class="funcionario-acoes">
                                                <a asp-controller="Funcionario"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="acao-editar">
                                                    Editar
                                                </a>

                                                <a asp-controller="Funcionario"
                                                   asp-action="Details"
                                                   asp-route-id="@item.Id"
                                                   class="acao-detalhes">
                                                    Detalhes
                                                </a>

                                                <a asp-controller="Funcionario"
                                                   asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="acao-excluir">
                                                    Excluir
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>

            <footer class="funcionarios-footer">
                Santa Massa · Painel de gerenciamento
            </footer>

        </section>

    </main>

</body>
</html>