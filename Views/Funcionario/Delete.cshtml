
@model GestaoReservas.Models.Funcionario

@{
    ViewData["Title"] = "Excluir Funcionário";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Excluir Funcionário | Santa Massa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Josefin+Sans:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <style>
        :root {
            --fundo: #181817;
            --cartao: #24231F;
            --cartao-item: #2D2B26;
            --dourado: #D3B779;
            --dourado-claro: #E8D5A5;
            --texto: #F5F1E8;
            --texto-secundario: #B5B0A5;
            --borda: #49443A;
            --vermelho: #C75B55;
            --vermelho-hover: #A9443E;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            background: var(--fundo);
            color: var(--texto);
            font-family: 'Poppins', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 18px;
        }

        .pagina {
            width: 100%;
            max-width: 540px;
        }

        .marca {
            text-align: center;
            margin-bottom: 28px;
        }

        .marca h1 {
            font-family: 'Josefin Sans', sans-serif;
            font-size: 30px;
            font-weight: 700;
            letter-spacing: 3px;
            color: var(--dourado-claro);
            margin-bottom: 8px;
        }

        .marca p {
            color: var(--texto-secundario);
            font-size: 11px;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .linha-dourada {
            width: 58px;
            height: 2px;
            background: var(--dourado);
            margin: 18px auto 0;
        }

        .card {
            background: var(--cartao);
            border: 1px solid var(--borda);
            border-radius: 8px;
            padding: 34px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.22);
        }

        .cabecalho {
            margin-bottom: 26px;
        }

        .cabecalho h2 {
            font-family: 'Josefin Sans', sans-serif;
            color: var(--dourado-claro);
            font-size: 25px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .cabecalho p {
            color: var(--texto-secundario);
            font-size: 13px;
            line-height: 1.7;
        }

        .aviso {
            padding: 14px 16px;
            background: rgba(199, 91, 85, 0.08);
            border: 1px solid rgba(199, 91, 85, 0.35);
            border-left: 3px solid var(--vermelho);
            border-radius: 4px;
            margin-bottom: 24px;
            color: #E6B7B2;
            font-size: 12px;
            line-height: 1.7;
        }

        .dados {
            background: var(--cartao-item);
            border: 1px solid var(--borda);
            border-radius: 5px;
            padding: 20px;
            margin-bottom: 22px;
        }

        .campo {
            margin-bottom: 18px;
        }

        .campo:last-child {
            margin-bottom: 0;
        }

        .campo label {
            display: block;
            color: var(--dourado);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 7px;
        }

        .valor {
            color: var(--texto);
            font-size: 14px;
            overflow-wrap: anywhere;
        }

        .acoes {
            display: flex;
            gap: 12px;
            margin-top: 28px;
        }

        .botao {
            flex: 1;
            min-height: 45px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 16px;
            border-radius: 4px;
            font-family: 'Poppins', sans-serif;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            text-align: center;
            cursor: pointer;
            transition: background 0.2s, border-color 0.2s;
        }

        .botao-voltar {
            color: var(--dourado-claro);
            background: transparent;
            border: 1px solid var(--borda);
        }

        .botao-voltar:hover {
            background: var(--cartao-item);
            border-color: var(--dourado);
            color: var(--dourado-claro);
        }

        .botao-excluir {
            color: #fff;
            background: var(--vermelho);
            border: 1px solid var(--vermelho);
        }

        .botao-excluir:hover {
            background: var(--vermelho-hover);
            border-color: var(--vermelho-hover);
        }

        .rodape {
            text-align: center;
            color: #77736A;
            font-size: 10px;
            margin-top: 22px;
            letter-spacing: 1px;
        }

        @@media (max-width: 480px) {
            body {
                padding: 22px 14px;
            }

            .marca h1 {
                font-size: 26px;
            }

            .card {
                padding: 24px 20px;
            }

            .cabecalho h2 {
                font-size: 23px;
            }

            .acoes {
                flex-direction: column-reverse;
            }

            .botao {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <main class="pagina">

        <header class="marca">
            <h1>SANTA MASSA</h1>
            <p>Gestão de Reservas</p>
            <div class="linha-dourada"></div>
        </header>

        <section class="card">

            <div class="cabecalho">
                <h2>Excluir funcionário</h2>
                <p>
                    Confira as informações do cadastro antes de confirmar
                    a exclusão do funcionário.
                </p>
            </div>

            <div class="aviso">
                <strong>Atenção:</strong>
                essa ação pode ser irreversível. Verifique os dados
                antes de continuar.
            </div>

            <div class="dados">

                <div class="campo">
                    <label>Nome completo</label>
                    <div class="valor">@Model.Nome</div>
                </div>

                <div class="campo">
                    <label>E-mail institucional</label>
                    <div class="valor">@Model.EmailInstitucional</div>
                </div>

                <div class="campo">
                    <label>CPF</label>
                    <div class="valor">@Model.Cpf</div>
                </div>

                <div class="campo">
                    <label>Código do funcionário</label>
                    <div class="valor">@Model.Id</div>
                </div>

            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="acoes">
                    <a asp-action="Index" class="botao botao-voltar">
                        Cancelar
                    </a>

                    <button type="submit" class="botao botao-excluir">
                        Confirmar exclusão
                    </button>
                </div>
            </form>

        </section>

        <footer class="rodape">
            SANTA MASSA · SISTEMA DE GESTÃO
        </footer>

    </main>
</body>
</html>
