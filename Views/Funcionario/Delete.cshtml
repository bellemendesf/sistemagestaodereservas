@* Tipo de dado (modelo) que esta view recebe do controller *@
@model GestaoReservas.Models.Funcionario

@* Bloco C#: configurações da view (título, layout e variáveis) *@
@{
    ViewData["Title"] = "Excluir funcionário";
    // CORREÇÃO: o layout _Layout.cshtml não existe; as views de Funcionario são páginas completas (Layout = null).
    Layout = null;
}
@* Tipo do documento (HTML5) *@
<!DOCTYPE html>
@* Início do documento HTML *@
<html lang="pt-BR">
@* Cabeçalho do documento (título, fontes e estilos) *@
<head>
    @* Configuração da página *@
    <meta charset="UTF-8">
    @* Configuração da página *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @* Título da aba *@
    <title>@ViewData["Title"] - Santa Massa</title>
    @* Arquivo de estilo/fonte externo *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
@* Corpo da página *@
<body>

@* Estilos desta página *@
<style>
    /* Estilo de: .delete-page */
    .delete-page {
        min-height: 75vh; /* altura mínima */
        display: flex; /* tipo de exibição */
        align-items: center; /* alinhamento vertical */
        justify-content: center; /* alinhamento horizontal */
        padding: 40px 20px; /* espaçamento interno */
        background: #f7f6f2; /* fundo */
    }

    /* Estilo de: .delete-card */
    .delete-card {
        width: 100%; /* largura */
        max-width: 540px; /* largura máxima */
        background: #fff; /* fundo */
        border: 1px solid #e8e2d5; /* borda */
        border-radius: 16px; /* cantos arredondados */
        padding: 36px; /* espaçamento interno */
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.07); /* sombra */
    }

    /* Estilo de: .delete-icon */
    .delete-icon {
        width: 62px; /* largura */
        height: 62px; /* altura */
        display: flex; /* tipo de exibição */
        align-items: center; /* alinhamento vertical */
        justify-content: center; /* alinhamento horizontal */
        margin: 0 auto 20px; /* espaçamento externo */
        border-radius: 50%; /* cantos arredondados */
        background: #fff3e8; /* fundo */
        color: #b45309; /* cor do texto */
        font-size: 28px; /* tamanho da fonte */
    }

    /* Estilo de: .delete-card h1 */
    .delete-card h1 {
        color: #24211d; /* cor do texto */
        font-size: 26px; /* tamanho da fonte */
        font-weight: 700; /* peso da fonte */
        text-align: center; /* alinhamento do texto */
        margin-bottom: 12px; /* margem inferior */
    }

    /* Estilo de: .delete-description */
    .delete-description {
        color: #777168; /* cor do texto */
        text-align: center; /* alinhamento do texto */
        font-size: 15px; /* tamanho da fonte */
        line-height: 1.6; /* altura da linha */
        margin-bottom: 28px; /* margem inferior */
    }

    /* Estilo de: .employee-info */
    .employee-info {
        background: #faf9f6; /* fundo */
        border: 1px solid #eee9df; /* borda */
        border-radius: 10px; /* cantos arredondados */
        padding: 20px; /* espaçamento interno */
        margin-bottom: 26px; /* margem inferior */
    }

    /* Estilo de: .info-label */
    .info-label {
        display: block; /* tipo de exibição */
        color: #888174; /* cor do texto */
        font-size: 12px; /* tamanho da fonte */
        font-weight: 700; /* peso da fonte */
        text-transform: uppercase; /* maiúsculas/minúsculas */
        letter-spacing: .7px; /* espaço entre letras */
        margin-bottom: 5px; /* margem inferior */
    }

    /* Estilo de: .info-value */
    .info-value {
        display: block; /* tipo de exibição */
        color: #29251f; /* cor do texto */
        font-size: 16px; /* tamanho da fonte */
        overflow-wrap: anywhere; /* quebra de palavras longas */
        margin-bottom: 16px; /* margem inferior */
    }

    /* Estilo de: .info-value:last-child */
    .info-value:last-child {
        margin-bottom: 0; /* margem inferior */
    }

    /* Estilo de: .delete-actions */
    .delete-actions {
        display: flex; /* tipo de exibição */
        gap: 12px; /* espaço entre itens */
    }

    /* Estilo de: .delete-actions .btn */
    .delete-actions .btn {
        flex: 1; /* proporção do item */
        padding: 12px 16px; /* espaçamento interno */
        border-radius: 8px; /* cantos arredondados */
        font-weight: 600; /* peso da fonte */
        text-align: center; /* alinhamento do texto */
        text-decoration: none; /* decoração do texto */
        transition: .2s ease; /* animação suave */
    }

    /* Estilo de: .btn-cancel */
    .btn-cancel {
        color: #34302a; /* cor do texto */
        background: #fff; /* fundo */
        border: 1px solid #d8d1c5; /* borda */
    }

    /* Estilo de: .btn-cancel:hover */
    .btn-cancel:hover {
        background: #f4f1eb; /* fundo */
        color: #24211d; /* cor do texto */
    }

    /* Estilo de: .btn-delete */
    .btn-delete {
        color: #fff; /* cor do texto */
        background: #a83232; /* fundo */
        border: 1px solid #a83232; /* borda */
        cursor: pointer; /* tipo de cursor */
    }

    /* Estilo de: .btn-delete:hover */
    .btn-delete:hover {
        background: #872626; /* fundo */
        border-color: #872626; /* cor da borda */
    }


</style>

@* Bloco (classe delete-page) *@
<div class="delete-page">
    @* Seção da página *@
    <section class="delete-card">

        @* Bloco (classe delete-icon) *@
        <div class="delete-icon">!</div>

        @* Título principal *@
        <h1>Excluir funcionário</h1>

        @* Parágrafo de texto *@
        <p class="delete-description">
            Tem certeza de que deseja excluir este funcionário?
            Essa ação poderá ser irreversível.
        </p>

        @* Bloco (classe employee-info) *@
        <div class="employee-info">
            @* Texto destacado *@
            <span class="info-label">Nome completo</span>
            @* Texto destacado *@
            <span class="info-value">@Model.Nome</span>

            @* Texto destacado *@
            <span class="info-label">CPF</span>
            @* Texto destacado *@
            <span class="info-value">@Model.Cpf</span>

            @* Texto destacado *@
            <span class="info-label">E-mail institucional</span>
            @* Texto destacado *@
            <span class="info-value">@Model.EmailInstitucional</span>
        </div>

        @* Formulário (asp-action Delete) *@
        <form asp-action="Delete" method="post">
            @* Token antifalsificação do formulário *@
            @Html.AntiForgeryToken()
            @* Campo de entrada (asp-for Id) *@
            <input type="hidden" asp-for="Id" />

            @* Bloco (classe delete-actions) *@
            <div class="delete-actions">
                @* Link (asp-action Index) *@
                <a asp-action="Index" class="btn btn-cancel">
                    Cancelar
                </a>

                @* Botão *@
                <button type="submit" class="btn btn-delete">
                    Confirmar exclusão
                </button>
            </div>
        </form>

    </section>
</div>
</body>
</html>
