@model GestaoReservas.Models.Funcionario
@{
    ViewData["Title"] = "Detalhes do funcionário";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Santa Massa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/DetalhesEdicao.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Listagens.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Reserva.css" asp-append-version="true">
</head>
<body class="detalhes-edicao-page has-fixed-page-top">
@await Component.InvokeAsync("ReservaPageTop")
    <main class="detalhes-edicao-container">
        <a asp-action="Index" class="detalhes-edicao-voltar">← Voltar à listagem de funcionários</a>

        <section class="detalhes-edicao-card">
            <header class="detalhes-edicao-header">
                <p class="detalhes-edicao-kicker">Santa Massa · Rio Preto</p>
                <h1>Detalhes do funcionário</h1>
                <p class="detalhes-edicao-descricao">
                    Consulta dos dados cadastrais (senha não é exibida por segurança).
                </p>
            </header>

            <div class="detalhes-edicao-conteudo">
                <div class="detalhes-edicao-grid">
                    <div class="detalhes-edicao-item">
                        <span>Código</span>
                        <strong>#@Model.Id</strong>
                    </div>

                    <div class="detalhes-edicao-item">
                        <span>Nome completo</span>
                        <strong>@(string.IsNullOrWhiteSpace(Model.Nome) ? "Não informado" : Model.Nome)</strong>
                    </div>

                    <div class="detalhes-edicao-item">
                        <span>CPF</span>
                        <strong>@(string.IsNullOrWhiteSpace(Model.Cpf) ? "Não informado" : Model.Cpf)</strong>
                    </div>

                    <div class="detalhes-edicao-item">
                        <span>E-mail institucional</span>
                        <strong>@(string.IsNullOrWhiteSpace(Model.EmailInstitucional) ? "Não informado" : Model.EmailInstitucional)</strong>
                    </div>
                </div>

                <div class="detalhes-edicao-acoes" style="margin-top: 28px;">
                    <a asp-action="Index"
                       class="detalhes-edicao-botao detalhes-edicao-botao-principal">
                        Voltar à listagem
                    </a>
                </div>
            </div>

            <footer class="detalhes-edicao-rodape">
                Santa Massa · Painel de gerenciamento
            </footer>
        </section>
    </main>
</body>
</html>
