
@* Tipo de dado (modelo) que esta view recebe do controller *@
@model List<GestaoReservas.Models.Cliente>

@* Bloco C#: configurações da view (título, layout e variáveis) *@
@{
    ViewData["Title"] = "Clientes";
    // Atribui Layout
    Layout = null;
    // Variável lista
    var lista = Model ?? new List<GestaoReservas.Models.Cliente>();
}

@* Tipo do documento (HTML5) *@
<!DOCTYPE html>
@* Início do documento HTML *@
<html lang="pt-BR">
@* Cabeçalho do documento (título, fontes e estilos) *@
<head>
    @* Configuração da página *@
    <meta charset="UTF-8">
    @* Configuração da página *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @* Título da aba *@
    <title>@ViewData["Title"]</title>

    @* Arquivo de estilo/fonte externo *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    @* Arquivo de estilo/fonte externo *@
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* Arquivo de estilo/fonte externo *@
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">


    @* Arquivo de estilo/fonte externo *@
    <link rel="stylesheet" href="~/css/DetalhesEdicao.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Clientes.css" asp-append-version="true">
</head>

@* Corpo da página *@
<body class="detalhes-edicao-page">
            <a asp-controller="AreaRestaurante"
           asp-action="Index"
           class="clientes-voltar">
            ← Voltar à área do restaurante
        </a>

    @* Conteúdo principal *@
    <main class="detalhes-edicao-container">

        @* Seção da página *@
        <section class="detalhes-edicao-card">

            @* Cabeçalho *@
            <header class="detalhes-edicao-header">
                @* Bloco (classe clientes-topo) *@
                <div class="clientes-topo">
                    @* Bloco *@
                    <div>
                        @* Parágrafo de texto *@
                        <p class="detalhes-edicao-kicker">
                            Santa Massa - Rio Preto
                        </p>

                        @* Título principal *@
                        <h1>Clientes</h1>

                        @* Parágrafo de texto *@
                        <p class="detalhes-edicao-descricao">
                            Consulte e gerencie os cadastros dos clientes do restaurante.
                        </p>
                    </div>

                    @* Texto destacado *@
                    <span class="clientes-contador">
                        @lista.Count @(lista.Count == 1 ? "cliente cadastrado" : "clientes cadastrados")
                    </span>
                </div>
            </header>

            @* Bloco (classe detalhes-edicao-conteudo) *@
            <div class="detalhes-edicao-conteudo">

                @* Mostra o bloco só se a condição for verdadeira *@
                @if (lista.Count == 0)
                {
                    @* Bloco (classe clientes-vazio) *@
                    <div class="clientes-vazio">
                        @* Bloco (classe clientes-vazio-icone) *@
                        <div class="clientes-vazio-icone">+</div>

                        @* Subtítulo *@
                        <h2>Nenhum cliente cadastrado</h2>

                        @* Parágrafo de texto *@
                        <p>
                            Cadastre o primeiro cliente para começar a organizar
                            os registros do restaurante.
                        </p>

                        @* Link *@
                        <a asp-controller="Cliente"
                           asp-action="Create"
                           class="clientes-botao-novo">
                            + Novo cadastro
                        </a>
                    </div>
                }
                @* Caso contrário, mostra este bloco *@
                else
                {
                    @* Bloco (classe clientes-acoes-topo) *@
                    <div class="clientes-acoes-topo">
                        @* Link *@
                        <a asp-controller="Cliente"
                           asp-action="Create"
                           class="clientes-botao-novo">
                            + Novo cadastro
                        </a>
                    </div>

                    @* Bloco (classe clientes-tabela-wrap) *@
                    <div class="clientes-tabela-wrap">
                        @* Tabela *@
                        <table class="clientes-tabela">
                            @* Cabeçalho da tabela *@
                            <thead>
                                @* Linha da tabela *@
                                <tr>
                                    @* Título da coluna *@
                                    <th>ID</th>
                                    @* Título da coluna *@
                                    <th>Nome</th>
                                    @* Título da coluna *@
                                    <th>CPF</th>
                                    @* Título da coluna *@
                                    <th>E-mail pessoal</th>
                                    @* Título da coluna *@
                                    <th>Telefone</th>
                                    @* Título da coluna *@
                                    <th>Ações</th>
                                </tr>
                            </thead>

                            @* Corpo da tabela *@
                            <tbody>
                                @* Repete o bloco para cada item da lista *@
                                @foreach (Cliente item in lista)
                                {
                                    @* Linha da tabela *@
                                    <tr>
                                        @* Célula *@
                                        <td class="cliente-id">
                                            #@item.Id
                                        </td>

                                        @* Célula *@
                                        <td class="cliente-nome">
                                            @item.Nome
                                        </td>

                                        @* Célula *@
                                        <td>@item.Cpf</td>

                                        @* Célula *@
                                        <td class="cliente-email">
                                            @item.EmailPessoal
                                        </td>

                                        @* Célula *@
                                        <td>@item.Telefone</td>

                                        @* Célula *@
                                        <td>
                                            @* Bloco (classe cliente-acoes) *@
                                            <div class="cliente-acoes">
                                                @* Link *@
                                                <a asp-controller="Cliente"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.Id">
                                                    Editar
                                                </a>

                                                @* Link *@
                                                <a asp-controller="Cliente"
                                                   asp-action="Details"
                                                   asp-route-id="@item.Id">
                                                    Detalhes
                                                </a>

                                                @* Link *@
                                                <a asp-controller="Cliente"
                                                   asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="cliente-excluir">
                                                    Excluir
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>

            @* Rodapé *@
            <footer class="clientes-rodape">
                Santa Massa - Painel de gerenciamento
            </footer>

        </section>
    </main>
</body>
</html>
