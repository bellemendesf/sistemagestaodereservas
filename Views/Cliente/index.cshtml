@model List<Cliente>
@* View Index de Cliente: apresenta os campos do DER via model MVC.
   As alterações passam pelo controller, que mantém uma lista em memória. *@
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Index - Cliente</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container py-4">
    <nav class="mb-4">
        <a href="/Cliente/Index">Clientes</a> |
        <a href="/Funcionario/Index">Funcionários</a>
    </nav>
    <h1>Clientes</h1>
    <a href="/Cliente/Create" class="btn btn-primary mb-3">Novo cadastro</a>
    @if (Model.Count == 0)
    {
        <p>Nenhum registro cadastrado.</p>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>ID</th><th>Nome</th><th>CPF</th><th>E-mail pessoal</th><th>Telefone</th><th>Ações</th></tr></thead>
            <tbody>
            @foreach (Cliente item in Model)
            {
                <tr>
                    <td>@item.Id</td><td>@item.Nome</td><td>@item.Cpf</td><td>@item.EmailPessoal</td><td>@item.Telefone</td>
                    <td>
                        <a href="/Cliente/Edit/@item.Id">Editar</a> |
                        <a href="/Cliente/Details/@item.Id">Detalhes</a> |
                        <a href="/Cliente/Delete/@item.Id">Excluir</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
</body>
</html>